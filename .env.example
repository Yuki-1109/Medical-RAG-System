# Copy to .env in the repository root. Never commit .env.
# Initialize-Database.ps1 generates a random password automatically on first use.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=medical_rag
DB_USERNAME=medical_rag
DB_PASSWORD=
SERVER_PORT=8080
FRONTEND_PORT=5173
# Optional: false for local HTTP; true only when actually serving over HTTPS.
SESSION_COOKIE_SECURE=false
# Optional A5 original-file storage; relative paths are resolved from the repository root.
# For Windows absolute paths prefer forward slashes. Preserve existing .env values.
APP_STORAGE_ROOT=data/originals
APP_STORAGE_MAX_PDF_BYTES=52428800
APP_STORAGE_MAX_IMAGE_BYTES=20971520
